<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFDF7">

    <TextView
        android:id="@+id/textPantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:text="My Pantry"
        android:textColor="#245C3A"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textPantryDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:text="Track the ingredients you have. Tap an item to edit it, or press and hold to delete it."
        android:textColor="#555555"
        android:textSize="16sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listPantryItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Saved pantry ingredients"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />

        <TextView
            android:id="@+id/textEmptyPantry"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="Your pantry is empty.&#10;Add your first ingredient."
            android:textColor="#666666"
            android:textSize="17sp" />

    </FrameLayout>

    <Button
        android:id="@+id/buttonAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Add Ingredient"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E8F5E9"
        android:padding="4dp">

        <Button
            android:id="@+id/buttonPantryHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Pantry"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonSuggestedRecipes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recipes"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
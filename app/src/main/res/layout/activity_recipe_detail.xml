<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textRecipeDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:text="Recipe Name"
            android:textColor="#245C3A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textColor="#245C3A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textRecipeIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Ingredient list"
            android:textColor="#444444"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation Method"
            android:textColor="#245C3A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textRecipeSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Preparation steps"
            android:textColor="#444444"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <Button
            android:id="@+id/buttonBackToSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Suggestions" />

    </LinearLayout>

</ScrollView>